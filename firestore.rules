rules_version = '2';
// Aðgangsreglur fyrir Lestrarstund.
// Hver fjölskylda er eitt skjal í families/{fid} með lista af foreldrum (members).
// Gögnin sjálf eru í undirsafninu families/{fid}/parts/{hluti}.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(fid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }

    // Hver notandi á eitt skjal sem vísar á fjölskylduna hans
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /families/{fid} {
      // Nýr aðgangur: fjölskyldan fær sama auðkenni og foreldrið sem stofnar hana
      allow create: if signedIn() && fid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      // Foreldri í fjölskyldunni má breyta henni (t.d. fjarlægja sig)
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        // ... eða nýtt foreldri gengur í hana með gildum boðskóða
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.family == fid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.exp > request.time
        )
      );

      match /parts/{part} {
        allow read, write: if isMember(fid);
      }
    }

    // Nafnlaus talning á notkun sagna (storyStats/{saga}, .../ends/{síða}, .../quits/{síða}).
    // Hver sem er má hækka teljara um nákvæmlega einn; aðeins umsjónarmaður má lesa.
    // Engin persónuauðkenni eru geymd í þessum skjölum.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'aronamagnusson@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function idOk(x) { return x.matches('^[A-Za-z0-9_]{1,40}$'); }
    function statKeys() { return ['started', 'finished', 's5', 's7', 's9', 'f5', 'f7', 'f9']; }
    function newStep(k) { return !(k in request.resource.data) || request.resource.data[k] == 1; }
    function updStep(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0)
        || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
    }
    match /storyStats/{sid} {
      allow read: if isAdmin();
      allow create: if idOk(sid) && request.resource.data.keys().hasOnly(statKeys())
        && newStep('started') && newStep('finished') && newStep('s5') && newStep('s7') && newStep('s9')
        && newStep('f5') && newStep('f7') && newStep('f9');
      allow update: if idOk(sid) && request.resource.data.keys().hasOnly(statKeys())
        && updStep('started') && updStep('finished') && updStep('s5') && updStep('s7') && updStep('s9')
        && updStep('f5') && updStep('f7') && updStep('f9');

      match /{kind}/{pid} {
        allow read: if isAdmin();
        allow create: if (kind == 'ends' || kind == 'quits') && idOk(pid)
          && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
        allow update: if (kind == 'ends' || kind == 'quits') && idOk(pid)
          && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      }
    }
    // Yfirlitið les alla enda og hættusíður í einu (collection group)
    match /{path=**}/ends/{pid} { allow read: if isAdmin(); }
    match /{path=**}/quits/{pid} { allow read: if isAdmin(); }

    // Nafnlausar villutilkynningar: hver sem er má búa til stutta tilkynningu,
    // aðeins umsjónarmaður má lesa og eyða. Engin persónuauðkenni.
    function shortStr(k, n) { return !(k in request.resource.data) || (request.resource.data[k] is string && request.resource.data[k].size() <= n); }
    match /errors/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['m', 's', 'v', 'b', 'w', 'd', 'sc'])
        && request.resource.data.m is string && request.resource.data.m.size() > 0
        && shortStr('m', 300) && shortStr('s', 160) && shortStr('v', 10) && shortStr('b', 12)
        && shortStr('w', 10) && shortStr('d', 10) && shortStr('sc', 20);
    }

    // Boðskóðar: 8 stafa kóði sem gildir í 7 daga
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && isMember(request.resource.data.family);
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
  }
}
